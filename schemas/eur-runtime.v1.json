{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trady:eur-runtime:1",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"enum": ["UNIVERSE", "QUOTE", "SELECTION", "SIGNAL", "TRADE_PLAN", "EXIT", "DAILY_REPORT", "WEEKLY_REPORT"]},
    "document": {"type": "object"}
  },
  "required": ["schema_version", "kind", "document"],
  "$defs": {
    "Id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"},
    "Hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "Time": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "Decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$", "maxLength": 48},
    "SelectionRun": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1}, "run_id": {"$ref": "#/$defs/Id"}, "account_id": {"$ref": "#/$defs/Id"},
        "session_id": {"$ref": "#/$defs/Id"}, "universe_snapshot_id": {"$ref": "#/$defs/Id"},
        "selected_instrument_id": {"anyOf": [{"$ref": "#/$defs/Id"}, {"type": "null"}]},
        "candidates": {"type": "array", "maxItems": 256}, "failure": {"type": ["object", "null"]}
      },
      "required": ["schema_version", "run_id", "account_id", "session_id", "universe_snapshot_id", "selected_instrument_id", "candidates", "failure"]
    },
    "VenueQuote": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "quote_id": {"$ref": "#/$defs/Id"}, "instrument_id": {"$ref": "#/$defs/Id"},
        "broker_instrument_id": {"$ref": "#/$defs/Id"}, "isin": {"type": "string", "pattern": "^[A-Z0-9]{12}$"},
        "exchange_mic": {"type": "string", "pattern": "^[A-Z0-9]{4}$"}, "currency": {"const": "EUR"},
        "yahoo_symbol": {"type": "string", "maxLength": 64}, "bid": {"anyOf": [{"$ref": "#/$defs/Decimal"}, {"type": "null"}]},
        "ask": {"anyOf": [{"$ref": "#/$defs/Decimal"}, {"type": "null"}]}, "observed_at": {"$ref": "#/$defs/Time"},
        "received_at": {"$ref": "#/$defs/Time"}, "market_state": {"enum": ["REGULAR", "PRE_MARKET", "POST_MARKET", "AUCTION", "CLOSED", "HALTED", "UNKNOWN"]},
        "quality": {"enum": ["EXECUTABLE", "LAST_TRADE_ONLY", "DELAYED", "STALE", "CROSSED", "VENUE_MISMATCH", "MISSING", "INVALID", "UNKNOWN"]}
      },
      "required": ["quote_id", "instrument_id", "broker_instrument_id", "isin", "exchange_mic", "currency", "yahoo_symbol", "bid", "ask", "observed_at", "received_at", "market_state", "quality"]
    },
    "TradePlan": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "plan_id": {"$ref": "#/$defs/Id"}, "policy_revision": {"$ref": "#/$defs/Id"}, "account_id": {"$ref": "#/$defs/Id"},
        "instrument_id": {"$ref": "#/$defs/Id"}, "currency": {"const": "EUR"}, "entry_price": {"$ref": "#/$defs/Decimal"},
        "quantity": {"$ref": "#/$defs/Decimal"}, "stop_price": {"$ref": "#/$defs/Decimal"}, "target_price": {"$ref": "#/$defs/Decimal"},
        "target_net_fraction": {"$ref": "#/$defs/Decimal"}, "planned_loss_fraction": {"$ref": "#/$defs/Decimal"},
        "flatten_deadline": {"$ref": "#/$defs/Time"}, "stop_revision": {"type": "integer", "minimum": 0}
      },
      "required": ["plan_id", "policy_revision", "account_id", "instrument_id", "currency", "entry_price", "quantity", "stop_price", "target_price", "target_net_fraction", "planned_loss_fraction", "flatten_deadline", "stop_revision"]
    }
  }
}
