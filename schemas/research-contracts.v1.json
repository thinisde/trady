{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trady:research-artifacts:1",
  "$ref": "#/$defs/StoreArtifactArguments",
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "Ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      },
      "uniqueItems": true,
      "maxItems": 32
    },
    "Text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "Texts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Text"
      },
      "maxItems": 16
    },
    "Time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$"
    },
    "Decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 48
    },
    "Currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "Coverage": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNAVAILABLE"
      ]
    },
    "SectorCode": {
      "enum": [
        "10",
        "15",
        "20",
        "25",
        "30",
        "35",
        "40",
        "45",
        "50",
        "55",
        "60"
      ]
    },
    "GroupCode": {
      "enum": [
        "1010",
        "1510",
        "2010",
        "2020",
        "2030",
        "2510",
        "2520",
        "2530",
        "2550",
        "3010",
        "3020",
        "3030",
        "3510",
        "3520",
        "4010",
        "4020",
        "4030",
        "4510",
        "4520",
        "4530",
        "5010",
        "5020",
        "5510",
        "6010",
        "6020"
      ]
    },
    "PriorityRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gics_code": {
          "oneOf": [
            {
              "$ref": "#/$defs/SectorCode"
            },
            {
              "$ref": "#/$defs/GroupCode"
            }
          ]
        },
        "calculation_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage_status": {
          "$ref": "#/$defs/Coverage"
        },
        "reason": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "gics_code",
        "calculation_id",
        "coverage_status",
        "reason"
      ]
    },
    "Screening": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_version": {
          "const": 1
        },
        "as_of": {
          "$ref": "#/$defs/Time"
        },
        "evidence_ids": {
          "$ref": "#/$defs/Ids"
        },
        "blockers": {
          "$ref": "#/$defs/Texts"
        },
        "kind": {
          "const": "SCREENING"
        },
        "stage": {
          "enum": [
            "SECTORS",
            "SUBSECTORS",
            "FINALIST"
          ]
        },
        "prior_screening_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "universe_snapshot_id": {
          "$ref": "#/$defs/Id"
        },
        "market_snapshot_id": {
          "$ref": "#/$defs/Id"
        },
        "rankings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PriorityRow"
          },
          "maxItems": 36,
          "minItems": 1
        },
        "selected_sector_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/SectorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_subsector_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/GroupCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "operating_branch": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_instrument_ids": {
          "$ref": "#/$defs/Ids",
          "maxItems": 5
        },
        "peer_instrument_ids": {
          "$ref": "#/$defs/Ids",
          "maxItems": 2
        },
        "finalist_instrument_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "exclusions": {
          "$ref": "#/$defs/Texts"
        }
      },
      "required": [
        "artifact_version",
        "as_of",
        "evidence_ids",
        "blockers",
        "kind",
        "stage",
        "prior_screening_id",
        "universe_snapshot_id",
        "market_snapshot_id",
        "rankings",
        "selected_sector_code",
        "selected_subsector_code",
        "operating_branch",
        "candidate_instrument_ids",
        "peer_instrument_ids",
        "finalist_instrument_id",
        "exclusions"
      ]
    },
    "FactDraft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "BUSINESS_MODEL",
            "SEGMENT_EXPOSURE",
            "FINANCIAL_METRIC",
            "RISK",
            "EVENT",
            "MANAGEMENT_STATEMENT"
          ]
        },
        "claim_type": {
          "enum": [
            "FACT",
            "FORECAST",
            "INTERPRETATION",
            "RUMOR"
          ]
        },
        "statement": {
          "$ref": "#/$defs/Text"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "$ref": "#/$defs/Currency"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "support_evidence_ids": {
          "$ref": "#/$defs/Ids"
        },
        "contradiction_evidence_ids": {
          "$ref": "#/$defs/Ids"
        }
      },
      "required": [
        "field",
        "claim_type",
        "statement",
        "value",
        "currency",
        "unit",
        "period",
        "support_evidence_ids",
        "contradiction_evidence_ids"
      ]
    },
    "ProfileReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_version": {
          "const": 1
        },
        "as_of": {
          "$ref": "#/$defs/Time"
        },
        "evidence_ids": {
          "$ref": "#/$defs/Ids"
        },
        "blockers": {
          "$ref": "#/$defs/Texts"
        },
        "kind": {
          "const": "PROFILE_REVIEW"
        },
        "issuer_entity_id": {
          "$ref": "#/$defs/Id"
        },
        "expected_profile_revision_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline_item_ids": {
          "$ref": "#/$defs/Ids"
        },
        "fact_drafts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FactDraft"
          },
          "maxItems": 24
        },
        "statement_evidence_ids": {
          "$ref": "#/$defs/Ids"
        },
        "coverage_status": {
          "$ref": "#/$defs/Coverage"
        },
        "gaps": {
          "$ref": "#/$defs/Texts"
        }
      },
      "required": [
        "artifact_version",
        "as_of",
        "evidence_ids",
        "blockers",
        "kind",
        "issuer_entity_id",
        "expected_profile_revision_id",
        "baseline_item_ids",
        "fact_drafts",
        "statement_evidence_ids",
        "coverage_status",
        "gaps"
      ]
    },
    "EconomicEdge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject_entity_id": {
          "$ref": "#/$defs/Id"
        },
        "target_entity_id": {
          "$ref": "#/$defs/Id"
        },
        "relation": {
          "enum": [
            "SUPPLIES",
            "CUSTOMER_OF",
            "PARTNERS_WITH",
            "COMPETES_WITH",
            "INVESTED_IN",
            "REGULATES",
            "LEADS"
          ]
        },
        "statement": {
          "$ref": "#/$defs/Text"
        },
        "valid_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/Time"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_until": {
          "anyOf": [
            {
              "$ref": "#/$defs/Time"
            },
            {
              "type": "null"
            }
          ]
        },
        "support_evidence_ids": {
          "$ref": "#/$defs/Ids"
        },
        "contradiction_evidence_ids": {
          "$ref": "#/$defs/Ids"
        }
      },
      "required": [
        "subject_entity_id",
        "target_entity_id",
        "relation",
        "statement",
        "valid_from",
        "valid_until",
        "support_evidence_ids",
        "contradiction_evidence_ids"
      ]
    },
    "Mention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "speaker_entity_id": {
          "$ref": "#/$defs/Id"
        },
        "target_entity_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "quoted_speaker_entity_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "item_id": {
          "$ref": "#/$defs/Id"
        },
        "locator": {
          "$ref": "#/$defs/Text"
        },
        "event_type": {
          "enum": [
            "PRAISES",
            "CRITICIZES",
            "MENTIONS",
            "QUOTES",
            "REPOSTS"
          ]
        },
        "distribution_kind": {
          "enum": [
            "ORIGINAL",
            "REPLY",
            "QUOTE",
            "REPOST"
          ]
        },
        "tone": {
          "enum": [
            "SUPPORTIVE",
            "CRITICAL",
            "NEUTRAL",
            "MIXED",
            "UNCLEAR"
          ]
        },
        "stance_confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "entity_resolution_confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "event_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Time"
            },
            {
              "type": "null"
            }
          ]
        },
        "materiality": {
          "enum": [
            "DIRECT",
            "INDIRECT",
            "IMMATERIAL",
            "UNKNOWN"
          ]
        },
        "transmission_hypothesis": {
          "$ref": "#/$defs/Text"
        },
        "support_evidence_ids": {
          "$ref": "#/$defs/Ids"
        },
        "contradiction_evidence_ids": {
          "$ref": "#/$defs/Ids"
        },
        "review_after": {
          "$ref": "#/$defs/Time"
        }
      },
      "required": [
        "speaker_entity_id",
        "target_entity_id",
        "quoted_speaker_entity_id",
        "item_id",
        "locator",
        "event_type",
        "distribution_kind",
        "tone",
        "stance_confidence",
        "entity_resolution_confidence",
        "event_at",
        "materiality",
        "transmission_hypothesis",
        "support_evidence_ids",
        "contradiction_evidence_ids",
        "review_after"
      ]
    },
    "RelationshipReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_version": {
          "const": 1
        },
        "as_of": {
          "$ref": "#/$defs/Time"
        },
        "evidence_ids": {
          "$ref": "#/$defs/Ids"
        },
        "blockers": {
          "$ref": "#/$defs/Texts"
        },
        "kind": {
          "const": "RELATIONSHIP_REVIEW"
        },
        "issuer_entity_id": {
          "$ref": "#/$defs/Id"
        },
        "profile_revision_id": {
          "$ref": "#/$defs/Id"
        },
        "reviewed_entity_ids": {
          "$ref": "#/$defs/Ids"
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EconomicEdge"
          },
          "maxItems": 16
        },
        "mentions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mention"
          },
          "maxItems": 24
        },
        "coverage_status": {
          "$ref": "#/$defs/Coverage"
        },
        "gaps": {
          "$ref": "#/$defs/Texts"
        }
      },
      "required": [
        "artifact_version",
        "as_of",
        "evidence_ids",
        "blockers",
        "kind",
        "issuer_entity_id",
        "profile_revision_id",
        "reviewed_entity_ids",
        "edges",
        "mentions",
        "coverage_status",
        "gaps"
      ]
    },
    "TopicTerm": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "WatchRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rule_key": {
          "$ref": "#/$defs/Id"
        },
        "category": {
          "enum": [
            "COMPANY",
            "PEOPLE",
            "THESIS",
            "RELATIONSHIP",
            "SECTOR"
          ]
        },
        "source_ids": {
          "$ref": "#/$defs/Ids"
        },
        "entity_ids": {
          "$ref": "#/$defs/Ids"
        },
        "social_account_ids": {
          "$ref": "#/$defs/Ids"
        },
        "topic_terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicTerm"
          },
          "maxItems": 12
        },
        "severity": {
          "enum": [
            "INFO",
            "MATERIAL",
            "CRITICAL"
          ]
        },
        "collect_seconds": {
          "enum": [
            60,
            300,
            900,
            3600
          ]
        },
        "cooldown_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "mandatory": {
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "rule_key",
        "category",
        "source_ids",
        "entity_ids",
        "social_account_ids",
        "topic_terms",
        "severity",
        "collect_seconds",
        "cooldown_seconds",
        "mandatory",
        "reason"
      ]
    },
    "WatchdogTemplate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_version": {
          "const": 1
        },
        "as_of": {
          "$ref": "#/$defs/Time"
        },
        "evidence_ids": {
          "$ref": "#/$defs/Ids"
        },
        "blockers": {
          "$ref": "#/$defs/Texts"
        },
        "kind": {
          "const": "WATCHDOG_TEMPLATE"
        },
        "instrument_id": {
          "$ref": "#/$defs/Id"
        },
        "issuer_entity_id": {
          "$ref": "#/$defs/Id"
        },
        "expected_template_revision_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "thesis_evidence_ids": {
          "$ref": "#/$defs/Ids"
        },
        "profile_review_id": {
          "$ref": "#/$defs/Id"
        },
        "relationship_review_id": {
          "$ref": "#/$defs/Id"
        },
        "mandatory_source_ids": {
          "$ref": "#/$defs/Ids"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WatchRule"
          },
          "maxItems": 24,
          "minItems": 1
        },
        "review_after": {
          "$ref": "#/$defs/Time"
        },
        "expires_at": {
          "$ref": "#/$defs/Time"
        }
      },
      "required": [
        "artifact_version",
        "as_of",
        "evidence_ids",
        "blockers",
        "kind",
        "instrument_id",
        "issuer_entity_id",
        "expected_template_revision_id",
        "thesis_evidence_ids",
        "profile_review_id",
        "relationship_review_id",
        "mandatory_source_ids",
        "rules",
        "review_after",
        "expires_at"
      ]
    },
    "OpportunityComparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_version": {
          "const": 1
        },
        "as_of": {
          "$ref": "#/$defs/Time"
        },
        "evidence_ids": {
          "$ref": "#/$defs/Ids"
        },
        "blockers": {
          "$ref": "#/$defs/Texts"
        },
        "kind": {
          "const": "OPPORTUNITY_COMPARISON"
        },
        "held_instrument_id": {
          "$ref": "#/$defs/Id"
        },
        "alternative_instrument_id": {
          "$ref": "#/$defs/Id"
        },
        "position_id": {
          "$ref": "#/$defs/Id"
        },
        "expected_plan_version": {
          "type": "integer",
          "minimum": 1
        },
        "alternative_dossier_id": {
          "$ref": "#/$defs/Id"
        },
        "rotation_calculation_id": {
          "$ref": "#/$defs/Id"
        },
        "horizon_at": {
          "$ref": "#/$defs/Time"
        },
        "requested_status": {
          "enum": [
            "RESEARCH_ONLY",
            "ELIGIBLE_FOR_VALIDATION"
          ]
        },
        "uncertainties": {
          "$ref": "#/$defs/Texts"
        }
      },
      "required": [
        "artifact_version",
        "as_of",
        "evidence_ids",
        "blockers",
        "kind",
        "held_instrument_id",
        "alternative_instrument_id",
        "position_id",
        "expected_plan_version",
        "alternative_dossier_id",
        "rotation_calculation_id",
        "horizon_at",
        "requested_status",
        "uncertainties"
      ]
    },
    "Artifact": {
      "oneOf": [
        {
          "$ref": "#/$defs/Screening"
        },
        {
          "$ref": "#/$defs/ProfileReview"
        },
        {
          "$ref": "#/$defs/RelationshipReview"
        },
        {
          "$ref": "#/$defs/WatchdogTemplate"
        },
        {
          "$ref": "#/$defs/OpportunityComparison"
        }
      ]
    },
    "StoreArtifactArguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/Artifact"
        }
      },
      "required": [
        "artifact"
      ]
    },
    "StoreArtifactResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/Id"
        },
        "artifact_kind": {
          "enum": [
            "SCREENING",
            "PROFILE_REVIEW",
            "RELATIONSHIP_REVIEW",
            "WATCHDOG_TEMPLATE",
            "OPPORTUNITY_COMPARISON"
          ]
        },
        "validation_status": {
          "enum": [
            "STORED_DRAFT",
            "VALIDATED",
            "BLOCKED"
          ]
        },
        "profile_revision_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "blockers": {
          "$ref": "#/$defs/Texts"
        }
      },
      "required": [
        "artifact_id",
        "artifact_kind",
        "validation_status",
        "profile_revision_id",
        "blockers"
      ]
    },
    "PerpetualReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assessment_id": {
          "$ref": "#/$defs/Id"
        },
        "influence": {
          "enum": [
            "USED",
            "DISAGREED",
            "ABSTAINED",
            "UNAVAILABLE"
          ]
        },
        "reason": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "assessment_id",
        "influence",
        "reason"
      ]
    },
    "FocusRefs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "universe_snapshot_id": {
          "$ref": "#/$defs/Id"
        },
        "screening_artifact_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile_review_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "relationship_review_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "watchdog_template_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "opportunity_comparison_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "perpetual_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/PerpetualReview"
            },
            {
              "type": "null"
            }
          ]
