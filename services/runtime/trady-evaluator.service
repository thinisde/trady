[Unit]
Description=Trady independent sealed evaluator

[Service]
Type=simple
User=trady-evaluator
Group=trady-evaluation-ipc
SupplementaryGroups=trady-evaluator
ExecStart=/usr/bin/python3 -B /opt/trady/lab/evaluator_worker.py --lock /etc/trady/evaluator/lock.json --socket /run/trady-evaluator/evaluator.sock --state-directory /var/lib/trady-evaluator/exposures
RuntimeDirectory=trady-evaluator
RuntimeDirectoryMode=0750
StateDirectory=trady-evaluator
StateDirectoryMode=0700
ExecStartPre=/usr/bin/mkdir -p -m 0700 /var/lib/trady-evaluator/exposures
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
# Accepted evaluator IPC replies need no outbound connect or io_uring support.
SystemCallArchitectures=native
SystemCallFilter=~connect io_uring_setup io_uring_enter io_uring_register
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/opt/trady /etc/trady/evaluator /var/lib/trady/sealed
ReadWritePaths=/var/lib/trady-evaluator /run/trady-evaluator
InaccessiblePaths=/etc/trady/secrets /var/lib/trady-lab
MemoryMax=3G
CPUQuota=200%
TasksMax=8
LimitCPU=1800
LimitNOFILE=32
LimitFSIZE=64M
TimeoutStopSec=5
KillMode=control-group
