[Unit]
Description=Trady executor (explicit reviewed account configuration)
Requires=trady-analyst.service
After=trady-analyst.service network-online.target

[Service]
User=trady-executor
Group=trady-executor
SupplementaryGroups=trady-ipc
ExecStart=/opt/trady/bin/trady autonomous run --config /etc/trady/runtime/executor.json
Environment=TRADY_CREDENTIALS_FILE=%d/credentials.json
LoadCredential=credentials.json:/etc/trady/secrets/executor.json
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/opt/trady /etc/trady/runtime /var/lib/trady/models
StateDirectory=trady-executor
ReadWritePaths=/var/lib/trady-executor
UMask=0077
MemoryMax=512M
CPUQuota=50%
TasksMax=32
TimeoutStopSec=20
KillMode=control-group
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
