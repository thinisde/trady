# Prepare only after full verification and final exact-hash owner approval.
# The receipt is created by the root activation helper, never by the executor.
EUR_RELEASE_BUNDLE=/var/lib/trady/releases/REPLACE_WITH_VERIFIED_MANIFEST_SHA256
EUR_OWNER_RECEIPT=/etc/trady/eur-approvals/REPLACE_WITH_VERIFIED_MANIFEST_SHA256/authority.json
