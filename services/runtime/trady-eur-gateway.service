[Unit]
Description=Trady EUR durable private-owner Telegram outbox
After=network-online.target
Wants=network-online.target

[Service]
User=trady-gateway
Group=trady-gateway
ExecStart=/opt/trady/bin/trady eur gateway --config /etc/trady/runtime/eur-shadow.json
Environment=TRADY_CREDENTIALS_FILE=%d/credentials.json
LoadCredential=credentials.json:/etc/trady/secrets/gateway.json
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/opt/trady /etc/trady/runtime
StateDirectory=trady-gateway
UMask=0077
MemoryMax=256M
TasksMax=24
TimeoutStopSec=15
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
