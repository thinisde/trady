[Unit]
Description=Trady EUR SHADOW coordinator (executor role, no broker mutations)
After=trady-eur-analyst.service network-online.target
Requires=trady-eur-analyst.service

[Service]
User=trady-executor
Group=trady-executor
ExecStart=/opt/trady/bin/trady autonomous run --config /etc/trady/runtime/eur-shadow.json
Environment=TRADY_CREDENTIALS_FILE=%d/credentials.json
LoadCredential=credentials.json:/etc/trady/secrets/executor.json
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/opt/trady /etc/trady/runtime
StateDirectory=trady-executor
UMask=0077
MemoryMax=512M
TasksMax=32
TimeoutStopSec=20
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
